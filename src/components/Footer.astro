---
const year = new Date().getFullYear();
---

<footer class="bg-white border-t border-gray-900/10">
  <div
    class="mx-auto max-w-7xl px-6 py-10 lg:px-8 flex flex-col items-center justify-between gap-6 sm:flex-row"
  >
    <p class="text-sm leading-6 text-gray-600">
      &copy; {year} 508.dev. All rights reserved.
    </p>
    <a
      href="https://identity.coop/"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-x-3 text-sm leading-6 text-gray-500 hover:text-gray-700"
    >
      <span>Verified co-op</span>
      <img
        src="/coop_blk.png"
        alt="Certified co-operative — identity.coop"
        class="h-6 w-auto"
        width="518"
        height="217"
      />
    </a>
  </div>
</footer>
